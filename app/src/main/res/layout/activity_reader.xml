<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_reader"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- Top Reading Progress Indicator -->
    <ProgressBar
        android:id="@+id/progress_reading_top"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_alignParentTop="true"
        android:max="100"
        android:progress="0"
        android:progressTint="@color/primary"
        android:progressBackgroundTint="@color/divider" />

    <!-- Reader Toolbar -->
    <LinearLayout
        android:id="@+id/toolbar_reader"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_below="@id/progress_reading_top"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:background="@color/surface">

        <ImageButton
            android:id="@+id/btn_reader_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_back"
            android:tint="@color/text_primary"
            android:contentDescription="@string/action_cancel" />

        <TextView
            android:id="@+id/tv_reader_progress_header"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="0% read"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:singleLine="true"
            android:ellipsize="end" />

        <ImageButton
            android:id="@+id/btn_reader_tts"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_tts"
            android:tint="@color/text_secondary"
            android:contentDescription="@string/action_tts" />

        <ImageButton
            android:id="@+id/btn_reader_speed"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_speed"
            android:tint="@color/text_secondary"
            android:contentDescription="@string/action_speed_read" />

        <ImageButton
            android:id="@+id/btn_reader_appearance"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_font"
            android:tint="@color/text_secondary"
            android:contentDescription="@string/action_appearance" />

        <ImageButton
            android:id="@+id/btn_reader_favorite"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_star"
            android:tint="@color/text_secondary"
            android:contentDescription="@string/action_favorite" />

        <ImageButton
            android:id="@+id/btn_reader_archive"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_archive"
            android:tint="@color/text_secondary"
            android:contentDescription="@string/action_archive" />

        <ImageButton
            android:id="@+id/btn_reader_share"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_share"
            android:tint="@color/text_secondary"
            android:contentDescription="@string/action_share" />
    </LinearLayout>

    <!-- Collapsible TTS Audio Control Bar -->
    <LinearLayout
        android:id="@+id/layout_tts_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/toolbar_reader"
        android:background="@color/surface_elevated"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="8dp"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/btn_tts_play_pause"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_pill_button"
            android:src="@drawable/ic_play"
            android:tint="@color/white"
            android:contentDescription="@string/action_tts" />

        <ImageButton
            android:id="@+id/btn_tts_stop"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_stop"
            android:tint="@color/text_secondary"
            android:contentDescription="@string/action_cancel" />

        <TextView
            android:id="@+id/tv_tts_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:text="Audio Reader Ready"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:singleLine="true"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tv_tts_speed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_chip"
            android:text="1.0x"
            android:textColor="@color/primary_light"
            android:textSize="12sp"
            android:textStyle="bold"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp" />

        <ImageButton
            android:id="@+id/btn_tts_close"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_delete"
            android:tint="@color/text_muted"
            android:contentDescription="@string/action_cancel" />
    </LinearLayout>

    <!-- Scrollable Article Reader Body -->
    <ScrollView
        android:id="@+id/scroll_reader"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/layout_tts_bar"
        android:fillViewport="true"
        android:scrollbars="vertical">

        <LinearLayout
            android:id="@+id/layout_reader_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="20dp"
            android:paddingBottom="64dp">

            <!-- Title -->
            <TextView
                android:id="@+id/tv_reader_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Article Title"
                android:textColor="@color/text_primary"
                android:textSize="26sp"
                android:textStyle="bold"
                android:lineSpacingMultiplier="1.2" />

            <!-- Byline & Metadata -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tv_reader_meta"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Author • Source • 5 min read"
                    android:textColor="@color/text_muted"
                    android:textSize="13sp" />
            </LinearLayout>

            <View
                android:id="@+id/view_reader_divider"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="20dp"
                android:background="@color/divider" />

            <!-- Main Text Content -->
            <TextView
                android:id="@+id/tv_reader_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Article content will appear here..."
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:lineSpacingMultiplier="1.5"
                android:textIsSelectable="true" />

            <!-- Bottom Actions -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="36dp"
                android:orientation="vertical"
                android:gravity="center">

                <Button
                    android:id="@+id/btn_reader_mark_completed"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_primary_button"
                    android:text="Mark as Finished &amp; Archive"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btn_reader_open_source"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_secondary_button"
                    android:text="Open Original Web Link"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</RelativeLayout>
