<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <!-- Top Action Bar -->
    <LinearLayout
        android:id="@+id/layout_speed_top"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="16dp">

        <ImageButton
            android:id="@+id/btn_speed_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_back"
            android:tint="@color/text_primary"
            android:contentDescription="@string/action_cancel" />

        <TextView
            android:id="@+id/tv_speed_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="@string/speed_reader_title"
            android:textColor="@color/text_primary"
            android:textSize="17sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tv_speed_current_wpm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_chip"
            android:text="350 WPM"
            android:textColor="@color/primary_light"
            android:textSize="13sp"
            android:textStyle="bold"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp" />
    </LinearLayout>

    <!-- Center RSVP Display Box -->
    <LinearLayout
        android:id="@+id/layout_rsvp_display"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:layout_centerInParent="true"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <!-- Top Guide Line with Center Tick -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider" />

        <TextView
            android:id="@+id/tv_rsvp_word"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:gravity="center"
            android:text="OffRead"
            android:textColor="@color/white"
            android:textSize="36sp"
            android:textStyle="bold" />

        <!-- Bottom Guide Line with Center Tick -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider" />

        <TextView
            android:id="@+id/tv_rsvp_context"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/press_play_to_start"
            android:textColor="@color/text_muted"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Bottom Controls Area -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="36dp">

        <!-- Word Progress Slider -->
        <SeekBar
            android:id="@+id/seek_speed_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="0"
            android:progressTint="@color/primary"
            android:thumbTint="@color/primary_light" />

        <TextView
            android:id="@+id/tv_speed_progress_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_marginTop="4dp"
            android:text="0 / 0 words (0%)"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <!-- Playback Controls -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            android:gravity="center">

            <Button
                android:id="@+id/btn_speed_rewind"
                android:layout_width="56dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_secondary_button"
                android:text="-10"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <ImageButton
                android:id="@+id/btn_speed_play_pause"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                android:background="@drawable/bg_pill_button"
                android:src="@drawable/ic_play"
                android:tint="@color/white"
                android:contentDescription="@string/press_play_to_start" />

            <Button
                android:id="@+id/btn_speed_forward"
                android:layout_width="56dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_secondary_button"
                android:text="+10"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- WPM Selector Pills -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn_wpm_250"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:gravity="center"
                android:background="@drawable/bg_chip"
                android:text="250"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btn_wpm_350"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:gravity="center"
                android:background="@drawable/bg_chip_active"
                android:text="350"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_wpm_450"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:gravity="center"
                android:background="@drawable/bg_chip"
                android:text="450"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btn_wpm_600"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:gravity="center"
                android:background="@drawable/bg_chip"
                android:text="600"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
